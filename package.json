{
  "name": "spa-prerender-static",
  "type": "module",
  "version": "0.0.1",
  "description": "A lightweight, framework-agnostic SPA prerendering library for generating SEO-friendly static HTML pages.",
  "author": "Rahul Sharma <rahu8299@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/rahulsushilsharma/spa-prerender-static#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulsushilsharma/spa-prerender-static.git"
  },
  "bugs": {
    "url": "https://github.com/rahulsushilsharma/spa-prerender-static/issues"
  },
  "keywords": [
    "spa",
    "prerender",
    "static-site",
    "seo",
    "html",
    "ssg",
    "vite",
    "frontend",
    "static-generation"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "publish": "pnpm run build && npm publish"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "bumpp": "^10.3.2",
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
